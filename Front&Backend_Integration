import tkinter as tk
from tkinter import ttk
from sympy import symbols, Function, Eq, dsolve, Derivative, simplify, exp, sin, cos

x = symbols('x')
y = Function('y')

class DiffEqApp(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title("Differential Equation Solver")
        self.geometry("900x700")
        self.frames = {}
        self.create_frames()
        self.show_frame("StartPage")

    def create_frames(self):
        for F in (StartPage, FirstOrderPage, SecondOrderPage,
                  SeparationPage, IntegratingFactorPage,
                  BernoulliPage, ExactPage, FirstLaplacePage,
                  SecondHomogeneousPage, SecondNonhomogeneousPage,
                  SecondLaplacePage):
            frame = F(self)
            self.frames[F.__name__] = frame
            frame.grid(row=0, column=0, sticky="nsew")

    def show_frame(self, page_name):
        frame = self.frames[page_name]
        frame.tkraise()

class StartPage(tk.Frame):
    def __init__(self, master):
        super().__init__(master)
        ttk.Label(self, text="Select Order of Differential Equation", font=("Arial", 18)).pack(pady=20)
        ttk.Button(self, text="First Order", command=lambda: master.show_frame("FirstOrderPage")).pack(pady=10)
        ttk.Button(self, text="Second Order", command=lambda: master.show_frame("SecondOrderPage")).pack(pady=10)

